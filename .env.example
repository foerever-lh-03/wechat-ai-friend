# DeepSeek API 配置（必填：https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 API 配置（必填：https://open.bigmodel.cn 获取，用于视觉识别+图片生成+embedding）
VISION_API_KEY=your-zhipu-key-here
VISION_MODEL=glm-4.6v-flash

# AI 好友名称（会出现在系统提示中）
AI_NAME=阿杰

# 称呼对方为
USER_NAME=你

# 白名单：只回复这些好友（逗号分隔的备注名），留空则回复所有人
ALIAS_WHITELIST=

# 群聊白名单：逗号分隔，留空则不在群聊回复
ROOM_WHITELIST=

# 触发词：消息以此开头才回复，留空则全部回复
TRIGGER_KEYWORD=

# 回复延迟范围（秒）
REPLY_DELAY_MIN=3
REPLY_DELAY_MAX=15

# 上下文窗口（轮数）
CONTEXT_WINDOW=20

# 免打扰时段（HH:MM格式，设为 off 则全天运行）
QUIET_START=23:00
QUIET_END=08:00

# 主动消息概率（0-1，每个检查周期的触发概率）
PROACTIVE_CHANCE=0.02

# 当前人设（me/cool/sister/brother）
PERSONA=me
